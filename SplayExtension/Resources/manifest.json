{
  "manifest_version": 3,
  "name": "Splay",
  "version": "1.0",
  "description": "Lets web pages use the full width of the iPhone Duo's front screen.",
  "icons": { "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png" },
  "permissions": ["storage", "nativeMessaging"],
  "background": { "scripts": ["background.js"], "type": "module", "persistent": false },
  "action": { "default_title": "Splay on this site", "default_icon": { "16": "toolbar-16.png", "32": "toolbar-32.png" } },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
